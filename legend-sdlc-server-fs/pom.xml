<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.finos.legend.sdlc</groupId>
        <artifactId>legend-sdlc</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>legend-sdlc-server-fs</artifactId>
    <name>Legend SDLC Server - FS (relocated)</name>
    <packaging>pom</packaging>

    <!--
     The file-system SDLC implementation was refit from a standalone server onto the backend SPI
     (re-architecture Phase 5). Its storage and lifecycle implementation now lives in legend-sdlc-backend-fs;
     the standalone server startup is gone - run the standard legend-sdlc-server with
     `backend: {type: fileSystem, rootDirectory: ...}` and legend-sdlc-backend-fs on the classpath instead.
     See docs/project-structure-migration.md.
    -->
    <distributionManagement>
        <relocation>
            <artifactId>legend-sdlc-backend-fs</artifactId>
            <message>legend-sdlc-server-fs was refit as legend-sdlc-backend-fs (a backend for the standard legend-sdlc-server, selected by backend: {type: fileSystem}); its standalone server startup no longer exists.</message>
        </relocation>
    </distributionManagement>
</project>
